# Discord Developer Portal -> Bot -> Token
DISCORD_TOKEN=

# 명령을 받을 서버(길드) ID
GUILD_ID=

# 명령을 받을 채널 ID (쉼표로 여러 개 가능, 이 채널들에서만 명령 인식)
COMMAND_CHANNEL_ID=

# 봇 결과를 그대로 보고 승인/거절할 사람(본인)의 디스코드 유저 ID
OWNER_ID=

# 명령 접두사 (쉼표로 여러 개, 이 문자열들 중 하나로 시작하는 메시지만 명령으로 인식)
COMMAND_PREFIXES=!ai,!수민

# 승인 대기 타임아웃 (분). 이 시간 안에 오너가 반응 안 하면 자동 반려.
APPROVAL_TIMEOUT_MINUTES=30

# 로컬 Unity 프로젝트 경로 (BaseProject 루트, git 저장소)
PROJECT_ROOT=C:\Users\dhtmd\Desktop\BaseProject

# git push 대상 브랜치
BASE_BRANCH=main

# claude 헤드리스 실행 1회당 최대 USD 지출 한도 (안전장치)
CLAUDE_MAX_BUDGET_USD=2

# claude 헤드리스 1회 최대 실행 시간 (분)
CLAUDE_TIMEOUT_MINUTES=15

# 봇이 "새 프로젝트" 명령으로 프로젝트를 만들 폴더 (기본: C:\Users\dhtmd\Projects)
# NEW_PROJECTS_ROOT=C:\Users\dhtmd\Projects
